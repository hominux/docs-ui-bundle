{{! Add additional meta tags here}}
<link rel="icon" type="image/x-icon" href="{{{uiRootPath}}}/img/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="{{{uiRootPath}}}/img/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="{{{uiRootPath}}}/img/favicon-180.png">
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
<link rel="stylesheet" href="{{{uiRootPath}}}/css/vendor/tabs.css">

{{! OpenGraphProtocol }}
<meta property="og:type" content="website">
{{#if site.title}}<meta property="og:site_name" content="{{site.title}}">{{/if}}
{{#if page.versions}}
<meta property="og:title" content="[{{page.componentVersion.displayVersion}}] {{{detag (or page.title 'Untitled')}}}">
{{else}}
<meta property="og:title" content="{{{detag (or page.title 'Untitled')}}}">
{{/if}}

{{#if page.description}}
<meta property="og:description" content="{{page.description}}">
{{else}}
<meta property="og:description" content="Hominux documentation.">
{{/if}}
{{#if (or (eq page.component.name "compress4j") (eq page.component.name "pact-avro-plugin"))}}
<meta property="og:image" content="{{ site.url }}{{ site.ui.url }}/img/{{page.component.name}}-logo.png">
{{else}}
<meta property="og:image" content="{{ site.url }}{{ site.ui.url }}/img/hominux-logo.png">
{{/if}}

