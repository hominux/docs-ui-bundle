    {{!-- Add additional meta tags here --}}
    <meta name="antora-ui-version" content="@@antora-ui-version"> {{!-- replaced by the gulp build --}}
    <meta name="version" content="{{{page.version}}}">
    <meta name="generation" content="{{{page.componentVersion.versionSegment}}}">
    <meta name="versioned-url" content="{{{versioned_url site.url page.componentVersion.versionSegment page.url}}}">
    <meta name="component" content="{{{page.component.name}}}">
    <meta name="latest-version" content="{{~#if (and page.latest (eq page.url page.latest.url))}}true{{~else}}false{{~/if}}">
    <meta property="og:type" content="website">
    {{#if site.title}}<meta property="og:site_name" content="{{site.title}}">{{/if}}
    {{#if page.versions}}
    <meta property="og:title" content="[{{page.componentVersion.displayVersion}}] {{{detag_attr (or page.title 'Untitled')}}}">
    {{else}}
    <meta property="og:title" content="{{{detag_attr (or page.title 'Untitled')}}}">
    {{/if}}
    {{#if page.description}}
    <meta property="og:description" content="{{page.description}}">
    {{else}}
    <meta property="og:description" content="{{or site.title 'Hominux'}} documentation.">
    {{/if}}
    <meta property="og:image" content="{{ site.url }}{{ site.ui.url }}/img/{{#if (component_logo page.component.name)}}{{component_logo page.component.name}}{{else}}{{or site.keys.socialImage 'hominux-logo.png'}}{{/if}}">
    {{#if site.keys.ownLinks}}<meta name="own-links" content="{{site.keys.ownLinks}}">{{/if}}
