<div class="nav-container"{{#if page.component}} data-component="{{page.component.name}}" data-version="{{page.version}}"{{/if}}>
  <aside class="nav">
    <div class="panels">
      <div class="nav-panel-menu is-active" data-panel="menu">
        <nav class="nav-menu">
{{> nav-explore}}
{{> nav-menu}}
          <div class="toggle-sm">
            <button id="nav-toggle-2" class="nav-toggle" aria-label="Toggle navigation"></button>
          </div>
        </nav>
      </div>
      <div class="nav-collapse">
        <button id="nav-collapse-toggle" aria-label="Collapse sidebar"><span></span></button>        
      </div>
    </div>
    <div class="nav-resize"></div>
  </aside>
</div>
<script>
!function () {
  try {
    if (window.localStorage.getItem('sidebar') === 'close') document.body.classList.add('nav-sm')
  } catch (e) {}
}()
</script>