    <script>
!function () {
  function read (key) {
    try { return window.localStorage.getItem(key) } catch (e) { return null }
  }
  var theme = read('theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches && 'dark')
  var navWidth = Number.parseInt(read('nav-width'), 10)
  if (theme === 'dark') document.documentElement.classList.add('dark-theme')
  if (Number.isFinite(navWidth)) {
    document.documentElement.style.setProperty('--nav-width', Math.min(600, Math.max(250, navWidth)) + 'px')
  }
}()
    </script>
    <link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
    <link rel="stylesheet" href="{{{uiRootPath}}}/css/vendor/search.css">
    <link rel="stylesheet" href="{{{uiRootPath}}}/css/vendor/{{#if (asciidocExtensionRegistered '@asciidoctor/tabs')}}asciidoctor{{else}}spring{{/if}}-tabs.css">
    {{#if site.keys.extraCss}}<link rel="stylesheet" href="{{{uiRootPath}}}/{{site.keys.extraCss}}">{{/if}}

